<Window x:Class="IPhoneMirror.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:IPhoneMirror"
        Title="iPhone" Width="400" Height="820" MinWidth="280" MinHeight="420"
        Background="#1C1C1E" Foreground="#F2F2F7" FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="#F2F2F7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3A3A3C" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#48484A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6">
            <Button Style="{StaticResource ToolButton}" Content="&#xE80F;" ToolTip="Ana ekran" Click="Home_Click" />
            <Button Style="{StaticResource ToolButton}" Content="&#xE8A9;" ToolTip="Uygulama değiştirici" Click="AppSwitcher_Click" />
            <Button Style="{StaticResource ToolButton}" Content="&#xE721;" ToolTip="Arama (Ctrl+Boşluk)" Click="Search_Click" />
            <Button Style="{StaticResource ToolButton}" Content="&#xE993;" ToolTip="Sesi azalt" Click="VolumeDown_Click" />
            <Button Style="{StaticResource ToolButton}" Content="&#xE995;" ToolTip="Sesi artır" Click="VolumeUp_Click" />
            <Button Style="{StaticResource ToolButton}" Content="&#xE7AD;" ToolTip="Yatay/dikey (görüntü döndüyse)" Click="Rotate_Click" />
            <Button Style="{StaticResource ToolButton}" Content="&#xE81D;" ToolTip="İmleci hizala (tıklamalar kaydıysa)" Click="Align_Click" />
            <Button Style="{StaticResource ToolButton}" Content="&#xE90F;" ToolTip="Kalibre et" Click="Calibrate_Click" />
        </StackPanel>

        <local:VideoHost x:Name="Video" Grid.Row="1" />

        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="10,5" FontSize="11" Foreground="#8E8E93"
                   TextTrimming="CharacterEllipsis" />
    </Grid>
</Window>
