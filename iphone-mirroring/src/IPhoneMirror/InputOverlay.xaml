<Window x:Class="IPhoneMirror.InputOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="#01000000"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" Cursor="Hand">
    <Border x:Name="HintPanel" Background="#E61C1C1E" Visibility="Collapsed">
        <TextBlock x:Name="HintText" Margin="24" VerticalAlignment="Center" TextAlignment="Center"
                   TextWrapping="Wrap" FontSize="14" LineHeight="21" Foreground="#F2F2F7"
                   FontFamily="Segoe UI Variable Text, Segoe UI" />
    </Border>
</Window>
