{
  "name": "apple-continuity-windows",
  "productName": "Süreklilik",
  "version": "0.1.0",
  "description": "Windows 11 için FaceTime ve Messages: iPhone'dan Windows'a görüşme devri ve iPhone kamerası",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/**/*.test.js\"",
    "dist": "npm run build:native && electron-builder --win nsis",
    "build:native": "dotnet publish native/MapBridge -c Release -o native/out"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "selfsigned": "^2.4.1",
    "socket.io-client": "^4.8.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.darkstone.continuity",
    "productName": "Süreklilik",
    "win": {
      "target": "nsis"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/out/MapBridge.exe",
        "to": "MapBridge.exe"
      }
    ],
    "icon": "build/icon.png"
  }
}
